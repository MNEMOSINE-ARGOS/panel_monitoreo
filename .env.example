# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEET_ID: ID of the Google Sheets database (defaults to production sheet)
GOOGLE_SHEET_ID="18GrnU-Q1Ci44zuiMj2fxjW169mHnKlrIRlfB-8PcPI0"

# GOOGLE_CLIENT_EMAIL: Service Account client email for Google Sheets API v4
GOOGLE_CLIENT_EMAIL=""

# GOOGLE_PRIVATE_KEY: Service Account private key (RSA) for Google Sheets API v4
GOOGLE_PRIVATE_KEY=""

# DATABASE_URL: Read-Only PostgreSQL Connection String for Phase 2 BI Architecture
# Format: postgres://username:password@host:port/database?sslmode=prefer
DATABASE_URL="postgres://username:password@host:port/database"
